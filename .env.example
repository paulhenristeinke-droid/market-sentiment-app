# Auth (NextAuth) - required for GitHub login
NEXTAUTH_SECRET=generate-a-random-string-here
NEXTAUTH_URL=http://localhost:3000
GITHUB_ID=your-github-oauth-app-id
GITHUB_SECRET=your-github-oauth-app-secret

# News API - get a free key at https://newsapi.org
NEWS_API_KEY=your-newsapi-key

# FinnHub - get a free key at https://finnhub.io
FINNHUB_API_KEY=your-finnhub-key

# Anthropic Claude API - get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key

# TradingView - no key needed (free widgets)
